<!doctype html>
<html>
<head><meta charset="utf-8"></head>
<body style="margin:0;padding:0;background:#f5f5f4;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;color:#1c1917;">
<div style="max-width:680px;margin:0 auto;padding:20px 16px;">

  <h1 style="font-size:20px;margin:0 0 4px;">📬 每日邮件摘要</h1>
  <div style="color:#78716c;font-size:13px;margin-bottom:20px;">{{ date }} · 共 {{ total }} 封
    {%- for acc, n in per_account.items() %} · {{ acc }} {{ n }}{% endfor %}</div>

  {% if tldr %}
  <div style="background:#fff;border-radius:10px;padding:14px 18px;margin-bottom:16px;border-left:4px solid #2563eb;">
    <div style="font-weight:600;margin-bottom:6px;">今日重点</div>
    <ul style="margin:0;padding-left:20px;line-height:1.6;">
      {% for t in tldr %}<li>{{ t }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if actions %}
  <div style="background:#fff;border-radius:10px;padding:14px 18px;margin-bottom:16px;border-left:4px solid #dc2626;">
    <div style="font-weight:600;margin-bottom:6px;">🔴 需要你处理 ({{ actions|length }})</div>
    {% for r in actions %}
    <div style="padding:8px 0;border-top:1px solid #f0efed;">
      <div><span style="font-size:11px;background:#e7e5e4;border-radius:4px;padding:1px 6px;margin-right:6px;">{{ r.email.account }}</span>
        <b>{{ r.item.action or r.item.summary }}</b>
        {% if r.item.deadline %}<span style="color:#dc2626;font-size:13px;"> · 截止 {{ r.item.deadline }}</span>{% endif %}</div>
      <div style="color:#57534e;font-size:13px;margin-top:2px;">{{ r.item.summary }}</div>
      <div style="color:#a8a29e;font-size:12px;margin-top:2px;">{{ r.email.sender }} ·
        {% if r.email.link %}<a href="{{ r.email.link }}" style="color:#2563eb;">{{ r.email.subject }}</a>{% else %}{{ r.email.subject }}{% endif %}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% for cat, rows in by_category.items() %}
  <div style="background:#fff;border-radius:10px;padding:14px 18px;margin-bottom:12px;">
    <div style="font-weight:600;margin-bottom:6px;">{{ cat }} ({{ rows|length }})</div>
    {% for r in rows %}
    <div style="padding:6px 0;border-top:1px solid #f0efed;font-size:14px;{% if r.item.priority == 3 %}color:#78716c;{% endif %}">
      <span style="font-size:11px;background:#e7e5e4;border-radius:4px;padding:1px 6px;margin-right:6px;">{{ r.email.account }}</span>
      {% if r.item.priority == 1 %}⭐ {% endif %}{{ r.item.summary }}
      {% if r.email.link %}<a href="{{ r.email.link }}" style="color:#2563eb;font-size:12px;text-decoration:none;"> ↗</a>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endfor %}

  <div style="color:#a8a29e;font-size:12px;margin-top:20px;line-height:1.6;">
    {% if promo_count %}已折叠 {{ promo_count }} 封推广邮件。<br>{% endif %}
    {% for err in errors %}<span style="color:#dc2626;">⚠️ {{ err }}</span><br>{% endfor %}
    由 samson_agent / email_agent 自动生成
  </div>
</div>
</body>
</html>
